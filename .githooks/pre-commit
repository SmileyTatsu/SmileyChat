#!/bin/sh
# Regenerates the published plugin API typings before every commit, so CI's
# `bun run plugin-types:check` cannot fail on a stale
# `types/smileychat-plugin-api.d.ts` and cost a follow-up commit.
#
# Installed automatically: `bun install` runs the `prepare` script, which points
# `core.hooksPath` at this folder. To install the hook in an existing clone
# without reinstalling, run `bun run setup:hooks`.
#
# Skip it with `SMILEYCHAT_SKIP_PLUGIN_TYPES=1 git commit ...` or `--no-verify`.

if [ "${SMILEYCHAT_SKIP_PLUGIN_TYPES:-0}" = "1" ]; then
    exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
    exit 0
fi

# Only TypeScript sources can change the generated declarations.
if ! printf '%s\n' "$staged" | grep -qE '\.(ts|tsx)$'; then
    exit 0
fi

echo "pre-commit: regenerating plugin API typings"
if ! bun run plugin-types; then
    echo "pre-commit: plugin-types failed; fix the error above or commit with --no-verify" >&2
    exit 1
fi

if ! git diff --quiet -- types/smileychat-plugin-api.d.ts; then
    git add types/smileychat-plugin-api.d.ts
    echo "pre-commit: staged types/smileychat-plugin-api.d.ts"
fi

exit 0
